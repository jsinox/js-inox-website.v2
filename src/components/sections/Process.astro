---
import { steps } from '../../data/site';
---
<section id="como-funciona" class="section"><div class="container">
 <div class="head"><p class="eyebrow">Como iniciar</p><h2>Da necessidade ao próximo passo.</h2>
  <p class="lead">Partilhe o que já sabe sobre a aplicação. A categoria, o local e as condições de atendimento precisam de ser confirmados antes de qualquer proposta.</p></div>
 <ol class="steps">{steps.map(([t, d], i) => <li><span class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><h3>{t}</h3><p>{d}</p></li>)}</ol>
</div></section>
<style>
.steps{list-style:none;margin:0;padding:0;display:grid;gap:0}
.steps li{position:relative;padding:0 0 2rem 3.5rem;border-left:2px solid var(--line);margin-left:1rem}.steps li:last-child{border-color:transparent;padding-bottom:0}
.n{position:absolute;left:-1.1rem;top:0;width:2.2rem;height:2.2rem;background:var(--red);color:#fff;font:800 .85rem var(--font-head);display:grid;place-items:center}
.steps h3{margin-bottom:.4rem}.steps p{color:var(--muted);max-width:34ch}
@media(min-width:900px){.steps{grid-template-columns:repeat(4,1fr);gap:1.5rem}.steps li{padding:3.25rem 0 0;border-left:0;border-top:2px solid var(--line);margin:0}.n{left:0;top:-1.1rem}}
</style>
