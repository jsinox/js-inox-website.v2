---
import { steps } from '../../data/site';
---
<section id="como-funciona" class="section process"><div class="container">
 <div class="head"><p class="eyebrow">Como iniciar</p><h2>Da necessidade ao próximo passo.</h2>
  <p class="lead">Partilhe o que já sabe sobre a aplicação. A categoria, o local e as condições de atendimento precisam de ser confirmados antes de qualquer proposta.</p></div>
 <ol class="steps">{steps.map(([title, text], index) => <li class="step"><span class="step__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><div class="step__content"><h3>{title}</h3><p>{text}</p></div></li>)}</ol>
</div></section>
<style>
.process{background:#fff}.steps{position:relative;display:grid;gap:0;margin:0;padding:0;list-style:none;counter-reset:step}.step{position:relative;display:grid;grid-template-columns:3rem 1fr;gap:1.1rem;padding:0 0 2rem}.step:not(:last-child)::before{position:absolute;top:2.4rem;bottom:.25rem;left:1.15rem;width:1px;background:linear-gradient(var(--red),var(--line));content:''}
.step__number{position:relative;z-index:1;display:grid;width:2.35rem;height:2.35rem;place-items:center;border:1px solid rgba(206,5,6,.35);border-radius:50%;color:var(--red-dark);background:#fff;font:800 .72rem var(--font-head);letter-spacing:.04em;box-shadow:0 0 0 .4rem #fff}
.step__content{padding:.2rem 0 0}.step h3{margin-bottom:.45rem}.step p{max-width:36ch;color:var(--muted);font-size:.96rem;line-height:1.65}
@media(min-width:900px){.steps{grid-template-columns:repeat(4,minmax(0,1fr));gap:1.5rem}.step{display:block;padding:0}.step:not(:last-child)::before{top:1.15rem;right:-1.5rem;bottom:auto;left:3rem;width:auto;height:1px;background:linear-gradient(90deg,var(--red),var(--line))}.step__number{margin-bottom:1.4rem}.step__content{padding:0}.step p{max-width:30ch}}
</style>
