---
import { solutions, solutionsNotice, waLink } from '../../data/site';
---
<section id="solucoes" class="section section--ice"><div class="container">
 <div class="head"><p class="eyebrow">Aplicações</p><h2>Estruturas e componentes em inox para áreas comerciais.</h2>
  <p class="lead">Descreva a aplicação pretendida e a unidade. A disponibilidade de cada categoria, material, acabamento e etapa de execução deve ser confirmada pela JS Inox antes de qualquer proposta.</p></div>
 <div class="solutions">{solutions.map((solution) => <article class="card card--cut solutions__card"><div class="solutions__media"><img class="ph" src={solution.image.src} width={solution.image.width} height={solution.image.height} alt={solution.image.alt} loading="lazy" /><span class="solutions__media-label">Referência visual</span></div><div class="solutions__body"><p class="solutions__index">01 / APLICAÇÃO</p><h3>{solution.title}</h3><p>{solution.text}</p><a class="link" href={waLink} target="_blank" rel="noopener">Conversar sobre a aplicação <span aria-hidden="true">↗</span></a></div></article>)}</div>
 <p class="note">{solutionsNotice}</p>
</div></section>
<style>
.solutions{max-width:74rem}.solutions__card{display:grid;grid-template-columns:1fr;gap:clamp(1.4rem,4vw,3.25rem);align-items:center;padding:clamp(.75rem,2vw,1.25rem);border-top:1px solid rgba(33,39,42,.08)}
.solutions__media{position:relative;overflow:hidden;min-height:15rem;border-radius:calc(var(--radius) - .45rem);background:#D8DCDE}.ph{width:100%;height:100%;min-height:15rem;aspect-ratio:16/10;object-fit:cover;filter:saturate(.84) contrast(1.03);transition:transform 700ms var(--ease)}
.solutions__media-label{position:absolute;bottom:1rem;left:1rem;padding:.55rem .8rem;border:1px solid rgba(255,255,255,.25);border-radius:var(--radius-pill);color:#fff;background:rgba(21,22,22,.72);backdrop-filter:blur(8px);font:700 .65rem var(--font-head);letter-spacing:.1em;text-transform:uppercase}
.solutions__body{display:flex;flex-direction:column;align-items:flex-start;padding:clamp(.5rem,2vw,1.5rem)}.solutions__index{margin-bottom:.85rem;color:var(--red);font:750 .7rem var(--font-head);letter-spacing:.13em}.solutions__body h3{max-width:18ch;font-size:clamp(1.45rem,2.5vw,2rem)}.solutions__body>p:not(.solutions__index){margin-top:.9rem;color:var(--muted);line-height:1.72}.link{display:inline-flex;align-items:center;gap:.65rem;margin-top:1.5rem;padding-bottom:.35rem;border-bottom:1px solid rgba(206,5,6,.35);color:var(--red-dark);font:750 .95rem var(--font-head);text-decoration:none}.link span{font-size:1.1rem;transition:transform var(--motion-fast) var(--ease)}.note{max-width:66ch;margin-top:1.25rem;color:var(--muted);font-size:.88rem;line-height:1.6}
@media(min-width:820px){.solutions__card{grid-template-columns:minmax(0,1.05fr) minmax(18rem,.95fr)}.ph{min-height:26rem;aspect-ratio:1.18}.solutions__media{min-height:26rem}}
@media(hover:hover){.solutions__card:hover .ph{transform:scale(1.035)}.link:hover span{transform:translate(3px,-2px)}}
</style>
