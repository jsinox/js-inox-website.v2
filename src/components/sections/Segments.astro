---
import { segments } from '../../data/site';
const paths: Record<string, string> = {
  store: 'M3 9l1.5-5h15L21 9M4 9v11h16V9M3 9h18M9 20v-6h6v6',
  boxes: 'M3 8l9-5 9 5v8l-9 5-9-5zM3 8l9 5 9-5M12 13v8',
  building: 'M5 21V4h9v17M14 9h5v12M3 21h18M8 8h3M8 12h3M8 16h3',
  network: 'M12 4v6M12 10H5v4M12 10h7v4M3 14h4v5H3zM17 14h4v5h-4zM10 3h4v3h-4z',
};
---
<section id="segmentos" class="section segments"><div class="container">
 <div class="head"><p class="eyebrow">Segmentos prioritários</p><h2>Soluções em inox para diferentes contextos comerciais.</h2>
  <p class="lead">Estes são os públicos em que a JS INOX concentra seu foco comercial.</p></div>
 <div class="grid g4 segments__grid">{segments.map((segment) => <article class="card segment-card"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d={paths[segment.icon]} /></svg><h3>{segment.title}</h3><p>{segment.text}</p><span class="segment-card__index" aria-hidden="true">{String(segments.indexOf(segment) + 1).padStart(2, '0')}</span></article>)}</div>
</div></section>
<style>
.segments{background:linear-gradient(180deg,#fff 0%,#FBFBFA 100%)}.segments__grid{align-items:stretch}.segment-card{min-height:15rem}.segment-card .icon{margin-bottom:.35rem}.segment-card h3{max-width:14ch}.segment-card__index{position:absolute;right:1.1rem;bottom:.75rem;color:rgba(32,35,38,.08);font:800 2rem/1 var(--font-head);letter-spacing:-.06em}
</style>
