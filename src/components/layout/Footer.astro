---
import { nav, site } from '../../data/site';
---
<footer class="ft"><div class="container">
 <div class="ft__main"><div class="ft__brand"><span class="ft__plate"><img src="/brand/logo-principal.png" width="640" height="640" alt="JS INOX e cozinhas" class="ft__logo" loading="lazy" /></span><p>JS INOX · {site.city}</p><a class="ft__location" href={site.locationUrl} target="_blank" rel="noopener noreferrer">Ver localização <span aria-hidden="true">↗</span></a></div>
  <nav aria-label="Rodapé"><p class="ft__label">Navegação</p><ul>{nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul></nav></div>
 <div class="ft__base"><span>JS INOX</span><a href="#topo">Voltar ao início <span aria-hidden="true">↑</span></a></div>
</div></footer>
<style>
.ft{position:relative;overflow:hidden;padding:3.5rem 0 1.25rem;border-top:1px solid rgba(255,255,255,.1);color:#C9CDD1;background:#141616}.ft::before{position:absolute;top:0;left:var(--gutter);width:4rem;height:2px;background:var(--red);content:''}.ft__main{display:grid;gap:2.5rem;padding-bottom:2.5rem}.ft__plate{display:inline-block;margin-bottom:1rem;padding:.7rem;border-radius:var(--radius-sm);background:#fff}.ft__logo{width:7rem;height:auto}.ft__brand p{color:#929A9E;font-size:.88rem}.ft__location{display:inline-flex;align-items:center;gap:.45rem;margin-top:.55rem;padding-bottom:.2rem;border-bottom:1px solid rgba(255,255,255,.22);color:#AEB5B8!important;font:700 .84rem var(--font-head)!important;text-decoration:none}.ft__location span{color:#FFBFC0}.ft__label{margin-bottom:.85rem;color:#81898D;font:750 .68rem var(--font-head);letter-spacing:.13em;text-transform:uppercase}.ft ul{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.5rem 1.25rem;margin:0;padding:0;list-style:none}.ft a{color:#F6F7F7;text-decoration:none;font:650 .86rem var(--font-head);transition:color var(--motion-fast)}.ft a:hover{color:#FFBFC0}.ft__base{display:flex;justify-content:space-between;gap:1rem;padding-top:1.1rem;border-top:1px solid rgba(255,255,255,.1);color:#788084;font:700 .65rem var(--font-head);letter-spacing:.13em}.ft__base a{color:#AEB5B8;letter-spacing:0}.ft__base a span{margin-left:.3rem;color:#fff}
@media(min-width:700px){.ft__main{grid-template-columns:1.2fr 1fr;align-items:start}.ft ul{grid-template-columns:repeat(2,max-content)}}
</style>
